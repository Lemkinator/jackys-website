---
// Theme is set to the transparent-light custom CSS at render time; theme.ts's
// applyGiscusTheme() swaps it client-side (to transparent_dark, or back to
// this same URL) once the iframe exists, to match the visitor's actual
// (possibly stored) choice.
function toGiscusTerm(pathname: string): string {
  return pathname.length < 2 ? 'index' : pathname.substring(1).replace(/\.\w+$/, '');
}

const term = toGiscusTerm(Astro.url.pathname);
---

<div data-reveal="up" style="max-width: var(--content-width); margin: 0 auto; padding: 0 var(--space-4);">
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo="Lemkinator/jackys-website"
    data-repo-id="R_kgDOJEZCMg"
    data-category="Comments"
    data-category-id="DIC_kwDOJEZCMs4DEBA4"
    data-mapping="specific"
    data-term={term}
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme={new URL('/giscus/transparent-light.css', Astro.url.origin).href}
    data-lang="de"
    data-loading="lazy"
    crossorigin="anonymous"
    async></script>
</div>
