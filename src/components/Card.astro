---
import { getImage } from 'astro:assets';

interface Props {
  // Omitted when the card carries its own interactive content via the
  // `media` slot (e.g. an <audio> player) instead of linking anywhere —
  // see the Tag branch below.
  href?: string;
  bgImg: ImageMetadata | string;
  title: string;
  description?: string;
  tags?: string[];
  // Shared-element name for the view-transition morph into the destination
  // page's Banner — must be unique per document, and bgImg must be the
  // exact same file as that Banner's image.
  transitionName?: string;
  revealIndex?: number;
  bgPosition?: string;
}

const { href, bgImg, title, description, tags = [], transitionName, revealIndex, bgPosition } = Astro.props;

const resolvedBg = typeof bgImg === 'string' ? bgImg : (await getImage({ src: bgImg, format: 'avif', width: 800 })).src;

// Narrow scroll-parallax swing around the card's own vertical focal point —
// same technique as Banner.astro's hasCustomFocal narrow swing, just a much
// smaller +/-4pt range since a card is far shorter than a full banner.
const focalY = Number(/(-?\d+(?:\.\d+)?)%\s*$/.exec(bgPosition ?? '')?.[1] ?? 50);
const narrowFrom = `${Math.max(0, focalY - 4)}%`;
const narrowTo = `${Math.min(100, focalY + 4)}%`;

const style = [
  `--bg-img: url(${resolvedBg})`,
  bgPosition && `--bg-pos: ${bgPosition}`,
  `--bg-pos-narrow-from: ${narrowFrom}`,
  `--bg-pos-narrow-to: ${narrowTo}`,
  transitionName && `view-transition-name: ${transitionName}`,
  revealIndex !== undefined && `--i: ${revealIndex}`,
]
  .filter(Boolean)
  .join('; ');

// A card without an href (a track card with an embedded player) renders as
// a div, not a link — an <audio controls> inside an <a> is invalid nesting
// of interactive controls.
const Tag = href ? 'a' : 'div';
---

<div class="card-perspective">
  <Tag class="card" href={href} style={style} data-reveal={revealIndex !== undefined ? 'stagger' : undefined} data-tilt>
    <div class="card__content">
      <h2>{title}</h2>
      {description && <p>{description}</p>}
      <slot name="media" />
      {
        tags.length > 0 && (
          <div class="card__tags">
            {tags.map((tag) => (
              <div class="card__tag">{tag}</div>
            ))}
          </div>
        )
      }
    </div>
  </Tag>
</div>
